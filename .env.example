# Firebase web config (PUBLIC client config — safe to expose, but not committed here).
# Copy this file to `.env` and fill in values from the Firebase console:
#   Project settings → General → Your apps → SDK setup and configuration.
# Leaving these blank runs the app in DEMO mode (local seed data + localStorage).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# UID of the Master Admin user you created in Firebase Authentication.
# Used by the Firestore security rules and shown in Settings → Data & sync.
VITE_MASTER_ADMIN_UID=
